# The Python extractor runs as a private service on the same machine.
COURSE_EXTRACTOR_URL=http://127.0.0.1:8010/extract

# Optional local-development Python path (for example, .venv/Scripts/python.exe).
COURSE_EXTRACTOR_PYTHON=

# Optional shared secret. Use the same value for the website and Python service.
COURSE_EXTRACTOR_TOKEN=

# Shared secret for POST /api/schedule/export (used by the Telegram bot to
# turn its selected courses into a PNG). Use the same value here and for the
# bot's SCHEDULE_EXPORT_TOKEN. This route is also blocked at the Nginx layer
# (see deploy/uniplan.nginx.conf) -- the token is defense in depth, not the
# only guard.
SCHEDULE_EXPORT_TOKEN=