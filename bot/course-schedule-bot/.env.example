# Copy to .env; never put real credentials in this example.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
AION_API_KEY=your-aion-api-key
# Set an exact model ID available to your Aion account.
AION_MODEL=
MIN_UNITS=16
MAX_UNITS=19
DATABASE_PATH=data/sessions.db


# Required website export. Use the same secret in the website environment.
# Same-host deployments can leave the URL at its default.
SCHEDULE_EXPORT_URL=http://127.0.0.1:3000/api/schedule/export
SCHEDULE_EXPORT_TOKEN=

# Per-request completion cap, including reasoning (128–2048).
AION_MAX_OUTPUT_TOKENS=512
# none disables reasoning on Aion 2.0/3.0/3.0 Mini; omitted for other models.
AION_REASONING_EFFORT=none
