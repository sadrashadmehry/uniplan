node_modules/
/.npm-cache/
.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.tsbuildinfo
/Niloofar/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
